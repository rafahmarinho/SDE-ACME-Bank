NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime, server only: JWT for the least-privilege bank_api database role (pnpm api-role-token).
SUPABASE_API_ROLE_TOKEN=
# Runtime, server only: 32+ random characters. Derives the browser storage and pseudonymization keys.
SERVER_SECRET=
# Operator tooling only (pnpm seed, pnpm api-role-token). Never set these in the runtime deployment.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DEMO_SEED_PASSWORD=
# Without the Supabase settings above, `pnpm dev` runs a local browser-only demo.
# Production builds never include the demo, whatever the environment says.
# Only a development server may fall back to a local stack's SUPABASE_SERVICE_ROLE_KEY when
# SUPABASE_API_ROLE_TOKEN is not set.
